  "version": 1,
  "about": "Shared money cases for packages/domain and the database (ADR-004, ARCHITECTURE 3.4). Expected values come from CONCEPT 1.2/2.5 and ARCHITECTURE 3.4/4.6/4.7, not from code. All sums are whole sums, rates are basis points. Fee cases use DEFAULT_FEE_SETTINGS version 2026-10-05.",
  "sections": {
    "applyBp": "domain and database: floor(base x rateBp / 10000) must equal the floor column",
    "split": "domain and database: largest-remainder split, ties to the lower index",
    "fee": "domain; the database checks fee_total = fee_commission_line + fee_works_line = fee_advance + fee_final on quotes",
    "payments": "domain validatePayment and the payments CHECK (3.4): valid=false must be rejected by both",
    "cancel": "domain settleCancellation; the database checks the closure invariant on fundsToRefund (3.4)"
  },

function nvOpenOrderNumbers() {
  return nvReadTable("orders")
    .filter((o) => ["closed", "cancelled", "podbor_delivered"].indexOf(o.code) < 0)
    .map((o) => o.num);
}
function nvAllOrderNumbers() {
  return nvReadTable("orders").map((o) => o.num);

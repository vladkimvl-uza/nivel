# Nivel environment. Copy is generated by `pnpm env:init` into .env.local (git-ignored).
# Never put real values into this file. Secrets live only in .env.local / server .env.

# --- runtime ---
# development | staging | production
APP_MODE=
# 0 = main folder, 1..9 = worktree; PORT_BASE = 3100 + 100 * slot
NIVEL_SLOT=

# --- databases (dev cluster 127.0.0.1:54329) ---
DATABASE_URL_WEB=
DATABASE_URL_ADMIN=
DATABASE_URL_BOT=
DATABASE_URL_WORKER=
DATABASE_URL_MIGRATOR=

# --- test cluster (127.0.0.1:54339); the harness rewrites the database name per vitest worker ---
TEST_DATABASE_URL_SUPER=
TEST_DATABASE_URL_MIGRATOR=
TEST_DATABASE_URL_WEB=
TEST_DATABASE_URL_ADMIN=
TEST_DATABASE_URL_BOT=
TEST_DATABASE_URL_WORKER=

# --- postgres container init (infra/postgres/init/01-roles.sh) ---
POSTGRES_PASSWORD=
NIVEL_MIGRATOR_PASSWORD=
NIVEL_WEB_PASSWORD=
NIVEL_ADMIN_PASSWORD=
NIVEL_BOT_PASSWORD=
NIVEL_WORKER_PASSWORD=
NIVEL_UMAMI_PASSWORD=
UMAMI_APP_SECRET=

# --- telegram bot (empty BOT_TOKEN = bot disabled, only /healthz) ---
BOT_TOKEN=
# polling | webhook
BOT_MODE=
BOT_WEBHOOK_SECRET=
# comma-separated Telegram user ids
TELEGRAM_OWNER_IDS=

# --- AI consultant (empty key or AI_ENABLED=false = "no AI" mode) ---
ANTHROPIC_API_KEY=
AI_ENABLED=

# --- keys (32 random bytes, base64) ---
DATA_ENC_KEY=
REVALIDATE_HMAC_KEY=
TMA_TOKEN_KEY=

# --- urls and storage ---
PUBLIC_BASE_URL=
ADMIN_BASE_URL=
FILES_DIR=
MEDIA_DIR=
